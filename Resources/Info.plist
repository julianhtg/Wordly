<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>dev.wordly.Wordly</string>
    <key>CFBundleName</key>
    <string>Wordly</string>
    <key>CFBundleExecutable</key>
    <string>Wordly</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.2.0</string>
    <key>CFBundleVersion</key>
    <string>3</string>
    <!-- Must track Package.swift's platform: the Parakeet engine needs 14.0,
         and a lower floor here only means macOS launches the app on a system
         where it cannot work. -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Wordly records audio while the hotkey is held and transcribes it locally on this Mac. Nothing leaves the device.</string>
</dict>
</plist>
